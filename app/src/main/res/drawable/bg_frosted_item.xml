<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted card behind list/grid items: light surface in light mode, dark surface in dark mode,
     slightly see-through so the (already blurred) theme art shows softly through. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="@dimen/list_selector_corner" />
			<solid android:color="@color/frosted_surface" />
			<stroke android:width="1dp" android:color="@color/frosted_stroke" />
		</shape>
	</item>
	<item android:drawable="@drawable/custom_selectable_item_background" />
</layer-list>
